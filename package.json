    "test": "vitest run"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "chalk": "^6.0.1",
    "commander": "^13.1.0",
    "simple-git": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
