{
  "name": "agkit",
  "version": "0.1.0",
  "description": "CLI for managing enterprise AI harness templates",
  "license": "Apache-2.0",
  "author": "Sekelenao",
  "homepage": "https://github.com/Sekelenao/AGKIT#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sekelenao/AGKIT.git"
  },
  "bugs": {
    "url": "https://github.com/Sekelenao/AGKIT/issues"
  },
  "keywords": [
    "ai",
