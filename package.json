{
  "name": "agkit",
  "version": "0.1.0",
  "description": "CLI for managing enterprise AI harness templates",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agkit": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"import('node:fs').then(fs => fs.chmodSync('dist/cli.js', 0o755))\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
